# Server Configuration
PORT=3400
NODE_ENV=development

# Database Configuration (MongoDB for layers/maps)
MONGO_URI=mongodb://localhost:27017/reid-analytics

# JWT Configuration
JWT_SECRET=your-secret-key-here
JWT_EXPIRE=30d

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Traits DB Handler API Configuration
TRAITS_API_URL=http://localhost:3001
TRAITS_API_KEY=your-secret-api-key-here

# Public base URL (used for image URLs in API responses, must be reachable by clients)
BASE_URL=http://localhost:3400

# Auto-save interval for layers (in milliseconds)
AUTO_SAVE_INTERVAL_LAYERS=300000

# Telegram MTProto credentials (from https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Phone number for automated Telegram OAuth (Sherlock bot link lookup)
TELEGRAM_PHONE=
# Switch to test DC (149.154.167.40:443) instead of production (149.154.167.50:443)
TELEGRAM_TEST_MODE=false
# Populated automatically after first auth (separate sessions per mode)
TELEGRAM_SESSION=
TELEGRAM_SESSION_TEST=

# --- Sherlock / OSINT features (disabled by default) ---
# Master switch for all Sherlock/OSINT functionality (phone-number lookup,
# OSINT asset endpoints, person info search). When false (default), the OSINT
# routes are not mounted and return 404. Set to true to enable.
ENABLE_OSINT=false

# Optional FlareSolverr proxy URL for OSINT scraping (leave empty to disable).
# Only used when ENABLE_OSINT=true.
FLARESOLVERR_URL=
