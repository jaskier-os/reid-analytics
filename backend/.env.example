# Server Configuration
PORT=3400
NODE_ENV=development

# Database Configuration (MongoDB for layers/maps)
MONGO_URI=mongodb://localhost:27017/reid-analytics

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5400,http://localhost:5173,http://localhost:8080

# Public base URL (used for image URLs in API responses, must be reachable by clients)
BASE_URL=http://localhost:3400

# Auto-save interval for layers (in milliseconds)
AUTO_SAVE_INTERVAL_LAYERS=300000

# ReID traits database handler API (reid-db-handler service)
TRAITS_API_URL=http://localhost:3001
TRAITS_API_KEY=your-traits-api-key-here

# ReID worker service (multi-camera person re-identification)
REID_WORKER_URL=http://localhost:5000

# Storage / media service API
STORAGE_SERVICE_URL=http://localhost:3300/api

# Orchestrator service (proxies Telegram MTProto / OSINT lookups)
ORCHESTRATOR_URL=http://localhost:10001
# API key sent to the orchestrator (x-api-key header)
API_KEY=your-orchestrator-api-key-here

# --- Sherlock / OSINT features (disabled by default) ---
# Master switch for all Sherlock/OSINT functionality (phone-number lookup,
# OSINT asset endpoints, person info search). When false (default), the OSINT
# routes are not mounted and return 404. Set to true to enable.
ENABLE_OSINT=false

# Phone number used for automated Telegram OAuth (Sherlock bot link lookup).
# Only used when ENABLE_OSINT=true.
TELEGRAM_PHONE=

# Optional FlareSolverr proxy URL for OSINT scraping (leave empty to disable).
# Only used when ENABLE_OSINT=true.
FLARESOLVERR_URL=
