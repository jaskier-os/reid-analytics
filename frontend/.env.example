# Which backend the Vite dev server proxies to: "remote" or "local".
# "remote" uses VITE_REMOTE_TARGET; "local" uses VITE_LOCAL_TARGET.
VITE_BACKEND=local

# API key forwarded as the x-api-key header when proxying to the remote backend.
VITE_API_KEY=your-api-key-here

# Remote backend target URL (used when VITE_BACKEND=remote). No trailing slash.
# Point this at the reid-analytics backend / gateway. Example: https://your-host:8443
VITE_REMOTE_TARGET=http://localhost:3400

# Local backend target URL (used when VITE_BACKEND=local).
VITE_LOCAL_TARGET=http://localhost:3400
